# Copy to .env (git-ignored) and fill each value with `openssl rand -base64 24` - Runbook 04, Step 3.
# These three values are the custody of the issuing CA's private key once it lives in PostgreSQL (Chapter 18, Section 18.3):
# a database backup without them is ciphertext; a database backup with them is the key. Store them accordingly.
DB_PASSWORD=
PASSWORD_ENCRYPTION_KEY=
CA_KEYSTOREPASS=
# Chapter 19 appendix / JDK 25 experiment only: SHA-256 of OpenJDK25U-jdk_x64_linux_hotspot_25.0.4.1_1.tar.gz from adoptium.net
TEMURIN_SHA256=
